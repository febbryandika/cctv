# Ronda — copy to .env and edit.  cp .env.example .env
#
# This file ships pointing at the Docker Compose Postgres, so a clean clone
# runs with no accounts to create and no internet beyond `docker pull`.

# ── Camera (SPEC 7) ────────────────────────────────────────────────────────
# The BARDI-family RTSP path is rtsp://<ip>:5543/<md5(ONVIF_PASSWORD)>/live/channel0
# — not /stream1. The path contains the password's MD5, so a leaked stream URL
# leaks a password hash. `bun run doctor` masks it when printing.
#
# These two render mediamtx.yml. After changing either, re-run:
#     cd apps/api && bun run render:mediamtx
CAMERA_IP=192.168.1.50
ONVIF_PASSWORD=change-me

# Docker Compose defaults the `yard` path to `publisher` so the fake camera can
# publish to it. To pull from the real camera instead, set this to the resolved
# URL — copy it out of the generated mediamtx.yml rather than assembling it by
# hand; the render script has already computed the hash. Nothing goes in here
# that is not already in that file.
# MTX_PATHS_YARD_SOURCE=

# ── MediaMTX (SPEC 7, 15) ──────────────────────────────────────────────────
# All loopback: the authenticated Hono API is the only way to reach a stream.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996

# ── Database (SPEC 5.2) ────────────────────────────────────────────────────
# Two URLs, one job each. DATABASE_URL is pooled (PgBouncer, `-pooler` host on
# Neon) and used at runtime. DATABASE_URL_DIRECT is unpooled and used ONLY by
# drizzle-kit: PgBouncer in transaction mode rejects the session-level
# statements migrations issue.
#
# Port 5439, not 5432: the standard port is usually taken by a native
# Postgres install. See the note in docker-compose.yml.
#
# To use Neon instead, swap in the pooled and unpooled connection strings and
# re-run the migration. Keep sslmode=require&channel_binding=require.
DATABASE_URL=postgres://ronda:ronda@127.0.0.1:5439/ronda
DATABASE_URL_DIRECT=postgres://ronda:ronda@127.0.0.1:5439/ronda

# ── Recording (SPEC 4.3) ───────────────────────────────────────────────────
RECORDINGS_DIR=./recordings

# ── Auth (SPEC 4.1, 15) ────────────────────────────────────────────────────
# Sign-up is disabled; the single operator account comes from `bun run db:seed`.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-32-byte-secret
BETTER_AUTH_URL=http://localhost:3001

# The operator account `bun run db:seed` creates. Defaults are baked into the
# script, so a clean clone seeds without touching this file; the README repeats
# them. Change them here for anything that is not a dummy install.
SEED_OPERATOR_EMAIL=operator@ronda.local
SEED_OPERATOR_PASSWORD=ronda-operator

# Origins allowed to call this API with credentials, comma-separated — used for
# both CORS and Better Auth's trustedOrigins. 3000 is `pnpm dev`, 3100 is
# Playwright (apps/web/playwright.config.ts); anything else is refused with 403.
WEB_ORIGIN=http://localhost:3000,http://localhost:3100

# ── Web → API (SPEC 6) ─────────────────────────────────────────────────────
# The web app never holds a database credential. It talks to Hono; Hono talks
# to Postgres.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Timeline (SPEC 8) ──────────────────────────────────────────────────────
# recordPath writes filenames in the SERVER's local time. Internally everything
# is epoch-ms UTC; this is the camera-local zone used at the render boundary.
TZ=Asia/Jakarta
